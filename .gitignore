# ==========================================
# FlucidOS Fetcher Repository
# ==========================================

# 1. External Sources (Managed by a separate Git remote)
pkg-src/
others/

# 2. Local State & Logs
fetcher.log
*.log
registry/registry.json

# 3. Backups & Archives
others/
*.zip
*.tar.gz
*.bak
*~

